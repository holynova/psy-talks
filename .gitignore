/helper-skills-dialogue-source-v2.zip
/tsconfig.tsbuildinfo
/.playwright-cli/
/.nojekyll

# Next static-export metadata files are not served by GitHub Pages
/**/__next*.txt
/**/index.txt

# Generated static-export surfaces kept outside the source tree
/_next/
/404.html
/404/
/_not-found/
/index.html
/index.txt
/v2/
/favicon.svg
/file.svg
/globe.svg
/window.svg
